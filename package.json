{
  "name": "gpon-fttx-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Inventario y Mapeo Lógico GPON / FTTx para GPON TELECOM S.A. de C.V.",
  "scripts": {
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "seed": "pnpm --filter backend run seed",
    "build": "pnpm --filter frontend build",
    "build:all": "pnpm --filter backend build && pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-harness": "^0.2.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/sequelize": "^6.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
